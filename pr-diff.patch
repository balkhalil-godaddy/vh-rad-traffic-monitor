+        if (this._events[event]) {
+            this._events[event].forEach(handler => handler(...args));
+        }
+    }
+
+    on(event, handler) {
+        if (!this._events[event]) {
+            this._events[event] = [];
+        }
+        this._events[event].push(handler);
+    }
+
+    removeAllListeners() {
+        this._events = {};
