+
+.data-table tbody tr {
+    transition: background-color 0.15s ease;
+}
+
+.data-table tbody tr:hover {
+    background: #fafafa;
+}
+
+.data-table tbody tr:last-child td {
+    border-bottom: none;
+}
+
+/* Event Name Styling */
+.event-link {
+    text-decoration: none;
+    color: inherit;
+    display: block;
+    transition: color var(--gd-transition-fast);
+}
+
+.event-link:hover {
+    color: var(--gd-color-orange-primary);
+}
+
+.event-name {
+    font-family: var(--gd-font-family-mono);
+    font-size: var(--gd-font-size-sm);
+    word-break: break-all;
+}
+
+/* Status Badges */
+.badge {
+    display: inline-block;
+    padding: 0.25rem 0.5rem;
+    border-radius: 0.25rem;
+    font-size: 0.75rem;
+    font-weight: 600;
+    text-transform: uppercase;
+    letter-spacing: 0.05em;
+}
+
+.badge.critical {
+    background: #ffebee;
+    color: #d72c0d;
+    border: 1px solid #f5c6cb;
+}
+
+.badge.warning {
+    background: #fffbe6;
+    color: #ffb900;
+    border: 1px solid #ffe9a0;
+}
+
+.badge.normal {
+    background: #e8f5e9;
+    color: #00a63f;
+    border: 1px solid #c3e6cb;
