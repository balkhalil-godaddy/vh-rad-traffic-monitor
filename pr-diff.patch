-    baseUrl: 'http://localhost:8889'
-});
-
-// Set authentication
-EnhancedApiClient.setElasticCookie('your-cookie-value');
-
-// Use typed endpoints
-const result = await EnhancedApiClient.getCurrentTrafficData('12h');
-if (result.success) {
-    console.log('Traffic events:', result.data.events);
