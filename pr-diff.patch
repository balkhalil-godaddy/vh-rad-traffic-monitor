+  /**
+   * Handle EID registration
+   */
+  private async handleRegistration(): Promise<void> {
+    const form = document.getElementById('eid-registration-form') as HTMLFormElement;
+    
+    const request: EIDRegistrationRequest = {
+      id: (document.getElementById('eid-id') as HTMLInputElement).value,
+      name: (document.getElementById('eid-name') as HTMLInputElement).value,
+      is_rad: (document.getElementById('eid-is-rad') as HTMLInputElement).checked,
+      is_experiment: (document.getElementById('eid-is-experiment') as HTMLInputElement).checked,
+      status: (document.getElementById('eid-status') as HTMLSelectElement).value as EIDStatus,
+      description: (document.getElementById('eid-description') as HTMLTextAreaElement).value || undefined,
+      owner: (document.getElementById('eid-owner') as HTMLInputElement).value || undefined,
+      tags: (document.getElementById('eid-tags') as HTMLInputElement).value
+        .split(',')
+        .map(t => t.trim())
+        .filter(t => t.length > 0) || undefined
+    };
+
+    try {
+      await this.options.registryService.registerEID(request);
+      this.hideRegistrationModal();
+      this.loadEIDs();
+      this.showSuccess('EID registered successfully');
+    } catch (error) {
+      this.showError(`Failed to register EID: ${error}`);
+    }
+  }
