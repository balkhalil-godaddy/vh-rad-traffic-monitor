+    // Schedule autocomplete
+    this.autocompleteTimer = setTimeout(() => {
+      this.performAutocomplete();
+    }, EDITOR_CONFIG.autocompleteDelay);
+  }
+
+  async performAutocomplete() {
+    const startTime = performance.now();
