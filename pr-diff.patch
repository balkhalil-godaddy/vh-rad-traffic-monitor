+    this.updateValidationStatus(this.lastParseResult.success, parseTime);
+  }
+
+  scheduleAutocomplete() {
+    // Clear existing timer
+    if (this.autocompleteTimer) {
+      clearTimeout(this.autocompleteTimer);
+    }
