@@ -0,0 +1,719 @@
+/**
+ * UX Components Styles
+ * Custom styles for @ux component integration
+ */
+
+/* Map Antares/GD variables to RAD theme variables */
+:root {
+  /* Map GD variables to RAD theme */
+  --gd-color-primary: var(--rad-text-accent);
+  --gd-color-primary-hover: var(--rad-bg-hover);
+  --gd-color-primary-subtle: rgba(255, 107, 0, 0.1);
+  --gd-color-text-on-primary: #fff;
+  
+  --gd-color-background-dark: var(--rad-bg-primary);
+  --gd-color-surface-dark: var(--rad-bg-secondary);
+  --gd-color-surface: var(--rad-bg-secondary);
+  --gd-color-surface-hover: var(--rad-bg-hover);
+  --gd-color-surface-subtle: rgba(42, 59, 82, 0.5);
+  --gd-color-surface-inverse: #000;
+  --gd-color-text-inverse: #fff;
+  
+  --gd-color-text-primary: var(--rad-text-primary);
+  --gd-color-text-secondary: var(--rad-text-secondary);
+  --gd-color-text-on-dark: var(--rad-text-primary);
+  --gd-color-text-muted: var(--rad-text-muted);
+  
+  --gd-color-border: var(--rad-border-primary);
+  --gd-color-border-subtle: var(--rad-border-secondary);
+  
+  --gd-color-success: var(--rad-text-success);
+  --gd-color-success-subtle: rgba(76, 175, 80, 0.1);
+  --gd-color-success-text: var(--rad-text-success);
+  
+  --gd-color-error: var(--rad-text-error);
+  --gd-color-error-subtle: rgba(244, 67, 54, 0.1);
+  --gd-color-error-text: var(--rad-text-error);
+  
+  --gd-color-warning: var(--rad-text-warning);
+  --gd-color-warning-subtle: rgba(255, 152, 0, 0.1);
+  --gd-color-warning-text: var(--rad-text-warning);
+  
+  --gd-color-info: var(--rad-text-info);
+  --gd-color-info-subtle: rgba(33, 150, 243, 0.1);
+  --gd-color-info-text: var(--rad-text-info);
+  
+  /* Spacing */
+  --gd-spacing-xs: var(--rad-spacing-xs);
+  --gd-spacing-sm: var(--rad-spacing-sm);
+  --gd-spacing-md: var(--rad-spacing-md);
+  --gd-spacing-lg: var(--rad-spacing-lg);
+  --gd-spacing-xl: var(--rad-spacing-xl);
+  
+  /* Typography */
+  --gd-font-family-primary: var(--rad-font-primary);
+  --gd-font-size-heading-1: var(--rad-font-xxl);
+  --gd-font-size-heading-2: var(--rad-font-xl);
+  --gd-font-size-heading-3: var(--rad-font-lg);
+  --gd-font-size-body: var(--rad-font-md);
+  --gd-font-size-body-large: var(--rad-font-lg);
+  --gd-font-size-body-small: var(--rad-font-sm);
+  --gd-font-size-caption: var(--rad-font-xs);
+  --gd-font-size-tiny: 11px;
+  
+  /* Border radius */
+  --gd-radius-sm: var(--rad-radius-sm);
+  --gd-radius-md: var(--rad-radius-md);
+  --gd-radius-lg: var(--rad-radius-lg);
+  --gd-radius-full: var(--rad-radius-round);
+  
+  /* Shadows */
+  --gd-shadow-sm: var(--rad-shadow-sm);
+  --gd-shadow-md: var(--rad-shadow-md);
+  --gd-shadow-lg: var(--rad-shadow-lg);
+  --gd-shadow-xl: var(--rad-shadow-modal);
+}
+
+/* Loading Overlay */
+.ux-loading-overlay {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  background: rgba(30, 40, 54, 0.95);
+  z-index: 9999;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  opacity: 0;
+  transition: opacity 0.3s ease;
+}
+
+.ux-loading-overlay--visible {
+  opacity: 1;
+}
+
+.ux-loading-overlay__content {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: var(--gd-spacing-xl);
+}
+
+.ux-loading-overlay__spinner {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: var(--gd-spacing-md);
+}
+
+.ux-loading-overlay__status-card {
