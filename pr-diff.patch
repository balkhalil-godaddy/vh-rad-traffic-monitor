+    border: 1px solid var(--gd-color-warning);
+}
+
+.example strong {
+    color: var(--gd-color-warning);
+}
+
+/* ============================================
+   Formula Editor Integration
+   ============================================ */
+
+#formulaEditorContainer {
+    margin-top: var(--gd-spacing-sm);
+}
+
+#formulaValidation {
+    margin-top: var(--gd-spacing-xs);
+    font-size: var(--gd-font-size-xs);
+    min-height: 20px;
+}
+
+.formula-status {
+    color: var(--gd-color-text-muted);
+    transition: color var(--gd-transition-fast);
+}
+
+.formula-status.ready {
+    color: var(--gd-color-success);
+}
+
+.formula-status.error {
+    color: var(--gd-color-error);
+}
+
+#testFormulaBtn {
+    width: 100%;
+    margin-top: var(--gd-spacing-xs);
+}
+
+#formulaResults {
+    margin-top: var(--gd-spacing-xs);
+    max-height: 150px;
+    overflow-y: auto;
+}
+
+#formulaResultsContent {
+    font-size: var(--gd-font-size-xs);
+    background: var(--gd-color-surface-variant);
+    padding: var(--gd-spacing-xs);
+    border-radius: var(--gd-radius-sm);
+    border: 1px solid var(--gd-color-border);
+}
+
+/* ============================================
+   Responsive Design
+   ============================================ */
+
+@media (max-width: 1024px) {
+    .control-panel {
+        width: 280px;
+    }
+
+    .main-content {
+        margin-left: 280px;
+    }
+}
+
+@media (max-width: 768px) {
+    .control-panel {
+        position: static;
+        width: 100%;
+        height: auto;
+        border-right: none;
+        border-bottom: 1px solid var(--gd-color-border);
+    }
+
+    .main-content {
+        margin-left: 0;
+        padding: var(--gd-spacing-md);
+    }
+
+    .summary {
+        grid-template-columns: 1fr 1fr;
+    }
+
+    .filters {
+        flex-direction: column;
+        align-items: stretch;
+    }
+
+    .search-input {
+        min-width: 100%;
+    }
+
+    .data-table {
+        font-size: var(--gd-font-size-xs);
+    }
+
+    .data-table th,
+    .data-table td {
+        padding: var(--gd-spacing-sm);
+    }
+}
+
+@media (max-width: 480px) {
+    .summary {
+        grid-template-columns: 1fr;
+    }
+
+    .header {
+        text-align: center;
+    }
+
+    .header h1 {
+        font-size: var(--gd-font-size-3xl);
+    }
+}
+
+/* ============================================
+   Utility Classes
+   ============================================ */
+
+.text-center { text-align: center; }
+.text-right { text-align: right; }
+.text-muted { color: var(--gd-color-text-muted); }
+.text-success { color: var(--gd-color-success); }
+.text-error { color: var(--gd-color-error); }
+.text-warning { color: var(--gd-color-warning); }
+.text-info { color: var(--gd-color-info); }
+
+/* Loading states */
+.loading {
+    position: relative;
+    opacity: 0.6;
+    pointer-events: none;
+}
+
+.loading::after {
+    content: '';
+    position: absolute;
+    top: 50%;
+    left: 50%;
+    width: 20px;
+    height: 20px;
+    margin: -10px 0 0 -10px;
+    border: 2px solid var(--gd-color-border);
+    border-top-color: var(--gd-color-orange-primary);
+    border-radius: var(--gd-radius-round);
+    animation: spin 0.8s linear infinite;
+}
