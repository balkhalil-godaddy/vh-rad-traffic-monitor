+    border: 2px solid var(--dark-bg-secondary);
+}
+
+.dark-theme ::-webkit-scrollbar-thumb:hover {
+    background: var(--dark-border-primary);
+}
+
+/* Results Info */
+.dark-theme .results-info {
+    color: var(--dark-text-tertiary);
+    font-size: 0.875rem;
+    padding: 0.5rem 0;
+}
+
+/* Number cells */
+.dark-theme .number {
+    font-variant-numeric: tabular-nums;
+    text-align: right;
+}
+
+/* AI Formula Input */
+.dark-theme .ai-formula-input {
+    background-color: var(--dark-bg-tertiary);
+    border: 1px solid var(--dark-border-primary);
+    color: var(--dark-text-primary);
+}
+
+.dark-theme .ai-formula-input:focus {
+    border-color: var(--dark-accent-primary);
+    box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.2);
+}
+
+/* Modal Overlays */
+.dark-theme .modal {
+    background-color: rgba(0, 0, 0, 0.9);
+}
+
+.dark-theme .modal-content {
+    background-color: var(--dark-bg-secondary);
+    border: 1px solid var(--dark-border-primary);
+    color: var(--dark-text-primary);
+}
+
+.dark-theme .modal-header {
+    border-bottom: 1px solid var(--dark-border-primary);
+}
+
+/* Accessibility - Focus States */
+.dark-theme *:focus-visible {
+    outline: 2px solid var(--dark-accent-primary);
+    outline-offset: 2px;
+}
+
+/* High Contrast Mode Support */
+@media (prefers-contrast: high) {
+    .dark-theme {
+        --dark-border-primary: #666666;
+        --dark-text-secondary: #ffffff;
+        --dark-text-tertiary: #e0e0e0;
