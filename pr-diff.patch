+            radId: parsed.radId || 'unknown',
+            subaction: parsed.subaction,
+            action: parsed.action,
+            lastSeen: new Date(),
+            frequency: 0,
+            ...additionalData
+        };
+    }
+}
+EIDParser.DEFAULT_NAMESPACE = 'pandc';
+EIDParser.DEFAULT_RADSET = 'vnext';
