+  /**
+   * Debounce utility
+   */
+  private debounce(func: Function, wait: number): (...args: any[]) => void {
+    let timeout: NodeJS.Timeout;
+    return (...args: any[]) => {
+      clearTimeout(timeout);
+      timeout = setTimeout(() => func(...args), wait);
+    };
+  }
