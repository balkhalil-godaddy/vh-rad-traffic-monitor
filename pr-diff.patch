+    text-align: left;
+    font-weight: 600;
+    color: #666;
+    text-transform: uppercase;
+    font-size: 0.75rem;
+    letter-spacing: 0.05em;
+    border-bottom: 1px solid #e8e8e8;
+}
+
+.data-table th[data-sort] {
+    cursor: pointer;
