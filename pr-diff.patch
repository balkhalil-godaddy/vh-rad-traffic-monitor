+    margin: 0;
+    font-family: var(--gd-font-family-mono);
+    font-size: var(--gd-font-size-sm);
+    line-height: var(--gd-line-height-paragraph);
+    white-space: pre-wrap;
+    word-wrap: break-word;
+    color: var(--gd-color-text-primary);
+}
+
+.preview-pane p {
+    color: var(--gd-color-text-muted);
+    font-style: italic;
+    text-align: center;
+    margin-top: var(--gd-spacing-2xl);
+}
+
+/* Math View */
+.math-expression {
+    padding: var(--gd-spacing-lg);
+}
+
+.math-expression h4 {
+    margin: 0 0 var(--gd-spacing-md) 0;
+    font-size: var(--gd-font-size-lg);
+    font-weight: var(--gd-font-weight-bold);
+    color: var(--gd-color-text-primary);
+}
+
+.math-content {
+    font-size: var(--gd-font-size-lg);
+    line-height: var(--gd-line-height-paragraph);
+}
+
+.math-content code {
+    background: var(--gd-color-background);
+    padding: var(--gd-spacing-xxs) var(--gd-spacing-xs);
+    border-radius: var(--gd-radius-sm);
+    font-family: var(--gd-font-family-mono);
+    color: var(--gd-color-orange-primary);
+}
+
+/* ============================================
+   Examples Section
+   ============================================ */
+
+.formula-examples {
+    background: var(--gd-color-surface);
+    border-radius: var(--gd-radius-lg);
+    box-shadow: var(--gd-shadow-sm);
+    padding: var(--gd-spacing-lg);
+    margin: 0 var(--gd-spacing-lg) var(--gd-spacing-lg) var(--gd-spacing-lg);
+}
+
+.formula-examples h3 {
+    margin: 0 0 var(--gd-spacing-md) 0;
+    font-size: var(--gd-font-size-xl);
+    font-weight: var(--gd-font-weight-bold);
+    color: var(--gd-color-text-primary);
+}
+
+.example-list {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+    gap: var(--gd-spacing-md);
+}
+
+.example-item {
+    padding: var(--gd-spacing-md);
+    background: var(--gd-color-surface-variant);
+    border-radius: var(--gd-radius-md);
+    cursor: pointer;
+    transition: all var(--gd-transition-fast);
+    border: 1px solid var(--gd-color-border);
+}
+
+.example-item:hover {
+    background: var(--gd-color-surface);
+    border-color: var(--gd-color-orange-primary);
+    transform: translateY(-1px);
+    box-shadow: var(--gd-shadow-sm);
+}
+
+.example-item strong {
+    display: block;
+    margin-bottom: var(--gd-spacing-xs);
+    color: var(--gd-color-text-primary);
+    font-size: var(--gd-font-size-md);
+    font-weight: var(--gd-font-weight-bold);
+}
+
+.example-item code {
+    font-size: var(--gd-font-size-sm);
+    color: var(--gd-color-text-secondary);
+    font-family: var(--gd-font-family-mono);
+    display: block;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+/* ============================================
+   Enhanced Formula Editor Component
+   ============================================ */
+
+enhanced-formula-editor {
+    display: block;
+    width: 100%;
+}
+
+enhanced-formula-editor .editor-container {
+    background: var(--gd-color-background);
+    border: 2px solid var(--gd-color-border);
+    border-radius: var(--gd-radius-md);
+    overflow: hidden;
+    transition: all var(--gd-transition-fast);
+}
+
+enhanced-formula-editor .editor-container:focus-within {
+    border-color: var(--gd-color-orange-primary);
+    box-shadow: 0 0 0 3px var(--gd-color-orange-light);
+}
+
+enhanced-formula-editor .editor-wrapper {
+    display: flex;
+    min-height: 100px;
+}
+
+enhanced-formula-editor .line-numbers {
+    background: var(--gd-color-surface-variant);
+    color: var(--gd-color-text-muted);
+    padding: var(--gd-spacing-sm);
+    font-family: var(--gd-font-family-mono);
+    font-size: var(--gd-font-size-sm);
+    line-height: var(--gd-line-height-paragraph);
+    user-select: none;
+    text-align: right;
+    min-width: 40px;
+}
+
+enhanced-formula-editor .editor-input {
+    flex: 1;
+    background: transparent;
+    border: none;
+    padding: var(--gd-spacing-sm);
+    font-family: var(--gd-font-family-mono);
+    font-size: var(--gd-font-size-sm);
+    line-height: var(--gd-line-height-paragraph);
+    color: var(--gd-color-text-primary);
+    resize: none;
+    outline: none;
+}
+
+enhanced-formula-editor .status-bar {
+    background: var(--gd-color-surface-variant);
+    padding: var(--gd-spacing-xxs) var(--gd-spacing-sm);
+    font-size: var(--gd-font-size-xs);
+    color: var(--gd-color-text-muted);
+    display: flex;
+    justify-content: space-between;
+}
+
+enhanced-formula-editor .autocomplete-container {
+    position: absolute;
+    background: var(--gd-color-surface);
+    border: 1px solid var(--gd-color-border);
+    border-radius: var(--gd-radius-md);
+    box-shadow: var(--gd-shadow-md);
+    max-height: 200px;
+    overflow-y: auto;
+    z-index: var(--gd-z-index-dropdown);
+}
+
+enhanced-formula-editor .autocomplete-item {
+    padding: var(--gd-spacing-sm);
+    cursor: pointer;
+    transition: background-color var(--gd-transition-fast);
+}
+
+enhanced-formula-editor .autocomplete-item:hover,
+enhanced-formula-editor .autocomplete-item.selected {
+    background: var(--gd-color-surface-variant);
+}
+
+enhanced-formula-editor .autocomplete-name {
+    font-weight: var(--gd-font-weight-medium);
+    color: var(--gd-color-text-primary);
+}
+
+enhanced-formula-editor .autocomplete-description {
+    font-size: var(--gd-font-size-xs);
+    color: var(--gd-color-text-muted);
+}
+
+/* ============================================
+   Responsive Design
+   ============================================ */
+
+@media (max-width: 1024px) {
+    .formula-builder-section {
+        flex-direction: column;
+    }
+
+    .function-palette {
+        width: 100%;
+        max-height: 300px;
+    }
+
+    .example-list {
+        grid-template-columns: 1fr;
+    }
+}
+
+@media (max-width: 768px) {
+    .formula-builder-section {
+        padding: var(--gd-spacing-md);
+        gap: var(--gd-spacing-md);
+    }
+
+    .function-palette,
+    .formula-input-section,
+    .preview-section,
+    .formula-examples {
+        padding: var(--gd-spacing-md);
+    }
+
+    .formula-toolbar {
+        flex-wrap: wrap;
+    }
+}
+
+/* ============================================
+   Scrollbar Styling
+   ============================================ */
+
+.function-list::-webkit-scrollbar,
+.preview-pane::-webkit-scrollbar {
+    width: 8px;
+}
+
+.function-list::-webkit-scrollbar-track,
+.preview-pane::-webkit-scrollbar-track {
+    background: var(--gd-color-surface-variant);
+    border-radius: var(--gd-radius-sm);
+}
+
+.function-list::-webkit-scrollbar-thumb,
+.preview-pane::-webkit-scrollbar-thumb {
+    background: var(--gd-color-border);
+    border-radius: var(--gd-radius-sm);
+}
+
+.function-list::-webkit-scrollbar-thumb:hover,
+.preview-pane::-webkit-scrollbar-thumb:hover {
+    background: var(--gd-color-gray-400);
+}
diff --git a/assets/css/formula-builder.css b/assets/css/formula-builder.css
new file mode 100644
index 0000000..ebb5d78
--- /dev/null
+++ b/assets/css/formula-builder.css
@@ -0,0 +1,477 @@
+/**
+ * Formula Builder Styles
+ */
+
+.formula-editor-container {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  background: var(--bg-primary, #f5f5f5);
+  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
+}
+
+.formula-builder-section {
+  display: flex;
+  flex: 1;
+  gap: 20px;
+  padding: 20px;
+}
+
+/* Function Palette */
+.function-palette {
+  width: 300px;
+  background: white;
+  border-radius: 8px;
+  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
+  padding: 20px;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+}
+
+.function-palette h3 {
+  margin: 0 0 15px 0;
+  font-size: 18px;
+  color: #333;
+}
+
+.function-search {
+  margin-bottom: 15px;
+}
+
+.function-search-input {
+  width: 100%;
+  padding: 8px 12px;
+  border: 1px solid #ddd;
+  border-radius: 4px;
+  font-size: 14px;
+  outline: none;
+}
+
+.function-search-input:focus {
+  border-color: #007bff;
+  box-shadow: 0 0 0 2px rgba(0, 123, 255, 0.1);
+}
+
+/* Category Tabs */
+.function-categories {
+  display: flex;
+  gap: 5px;
+  margin-bottom: 15px;
+  flex-wrap: wrap;
+}
+
+.category-tab {
+  padding: 6px 12px;
+  border-radius: 4px;
+  background: #f0f0f0;
+  cursor: pointer;
+  font-size: 12px;
+  font-weight: 500;
+  transition: all 0.2s ease;
+  white-space: nowrap;
+}
+
+.category-tab:hover {
+  background: #e0e0e0;
+}
+
+.category-tab.active {
+  background: #007bff;
+  color: white;
+}
+
+/* Function List */
+.function-list {
+  flex: 1;
+  overflow-y: auto;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.function-item {
+  padding: 12px;
+  background: #f9f9f9;
+  border-radius: 6px;
+  cursor: pointer;
+  transition: all 0.2s ease;
+  border: 1px solid transparent;
+}
+
+.function-item:hover {
+  background: #f0f0f0;
+  border-color: #007bff;
+  transform: translateY(-1px);
+}
+
+.function-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: 6px;
+}
+
+.function-name {
+  font-weight: 600;
+  color: #333;
+  font-size: 14px;
+}
+
+.function-category {
+  font-size: 11px;
+  padding: 2px 6px;
+  border-radius: 3px;
+  background: #e0e0e0;
+  color: #666;
+}
+
+.function-description {
+  font-size: 12px;
+  color: #666;
+  margin-bottom: 6px;
+  line-height: 1.4;
+}
+
+.function-signature {
+  font-size: 11px;
+  font-family: 'Monaco', 'Menlo', monospace;
+  color: #888;
+  background: #f5f5f5;
+  padding: 4px 6px;
+  border-radius: 3px;
+}
+
+/* Editor Area */
+.editor-area {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+}
+
+/* Formula Input Section */
+.formula-input-section {
+  background: white;
+  border-radius: 8px;
+  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
+  padding: 20px;
+}
+
+.formula-input-section h3 {
+  margin: 0 0 15px 0;
+  font-size: 18px;
+  color: #333;
+}
+
+.formula-toolbar {
+  display: flex;
+  gap: 10px;
+  margin-bottom: 15px;
+}
+
+.formula-toolbar button {
+  padding: 6px 16px;
+  border: 1px solid #ddd;
+  border-radius: 4px;
+  background: white;
+  cursor: pointer;
+  font-size: 14px;
+  transition: all 0.2s ease;
+}
+
+.formula-toolbar button:hover {
+  background: #f0f0f0;
+  border-color: #007bff;
+}
+
+.formula-input {
+  width: 100%;
+  min-height: 120px;
+  padding: 12px;
+  border: 1px solid #ddd;
+  border-radius: 4px;
+  font-family: 'Monaco', 'Menlo', monospace;
+  font-size: 14px;
+  resize: vertical;
+  outline: none;
+}
+
+.formula-input:focus {
+  border-color: #007bff;
+  box-shadow: 0 0 0 2px rgba(0, 123, 255, 0.1);
+}
+
+.formula-status {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin-top: 10px;
+}
+
+.status-indicator {
+  width: 10px;
+  height: 10px;
+  border-radius: 50%;
+  background: #ddd;
+}
+
+.status-indicator.valid {
+  background: #28a745;
+}
+
+.status-indicator.error {
+  background: #dc3545;
+}
+
+.status-indicator.info {
+  background: #17a2b8;
+}
+
+.status-message {
+  font-size: 13px;
+  color: #666;
+}
+
+/* Preview Section */
+.preview-section {
+  flex: 1;
+  background: white;
+  border-radius: 8px;
+  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
+  padding: 20px;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+}
+
+.preview-section h3 {
+  margin: 0 0 15px 0;
+  font-size: 18px;
+  color: #333;
+}
+
+.preview-tabs {
+  display: flex;
+  gap: 5px;
+  margin-bottom: 15px;
+  border-bottom: 1px solid #e0e0e0;
+  padding-bottom: 10px;
+}
+
+.preview-tab {
+  padding: 6px 16px;
+  cursor: pointer;
+  font-size: 14px;
+  color: #666;
+  transition: all 0.2s ease;
+  border-bottom: 2px solid transparent;
+  margin-bottom: -11px;
+}
+
+.preview-tab:hover {
+  color: #333;
+}
+
+.preview-tab.active {
+  color: #007bff;
+  border-bottom-color: #007bff;
+  font-weight: 500;
+}
+
+.preview-content {
+  flex: 1;
+  position: relative;
+  overflow: hidden;
+}
+
+.preview-pane {
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  overflow: auto;
+  display: none;
+  padding: 10px;
+  background: #f9f9f9;
+  border-radius: 4px;
+}
+
+.preview-pane.active {
+  display: block;
+}
+
+.preview-pane pre {
+  margin: 0;
+  font-family: 'Monaco', 'Menlo', monospace;
+  font-size: 12px;
+  line-height: 1.5;
+  white-space: pre-wrap;
+  word-wrap: break-word;
+}
+
+.preview-pane p {
+  color: #888;
+  font-style: italic;
+  text-align: center;
+  margin-top: 40px;
+}
+
+/* Math View */
+.math-expression {
+  padding: 20px;
+}
+
+.math-expression h4 {
+  margin: 0 0 15px 0;
+  font-size: 16px;
+  color: #333;
+}
+
+.math-content {
+  font-size: 18px;
+  line-height: 1.6;
+}
+
+.math-content code {
+  background: #f5f5f5;
+  padding: 4px 8px;
+  border-radius: 3px;
+  font-family: 'Monaco', 'Menlo', monospace;
+}
+
+/* Examples */
+.formula-examples {
+  background: white;
+  border-radius: 8px;
+  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
+  padding: 20px;
+  margin: 0 20px 20px 20px;
+}
+
+.formula-examples h3 {
+  margin: 0 0 15px 0;
+  font-size: 18px;
+  color: #333;
+}
+
+.example-list {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 15px;
+}
+
+.example-item {
+  padding: 12px;
+  background: #f9f9f9;
+  border-radius: 6px;
+  cursor: pointer;
+  transition: all 0.2s ease;
+  border: 1px solid transparent;
+}
+
+.example-item:hover {
+  background: #f0f0f0;
+  border-color: #007bff;
+  transform: translateY(-1px);
+}
+
+.example-item strong {
+  display: block;
+  margin-bottom: 6px;
+  color: #333;
+  font-size: 14px;
+}
+
+.example-item code {
+  font-size: 12px;
+  color: #666;
+  font-family: 'Monaco', 'Menlo', monospace;
+  display: block;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* Responsive Design */
+@media (max-width: 1024px) {
+  .formula-builder-section {
+    flex-direction: column;
+  }
+
+  .function-palette {
+    width: 100%;
+    max-height: 300px;
+  }
+
+  .example-list {
+    grid-template-columns: 1fr;
+  }
+}
+
+/* Dark Mode Support */
+@media (prefers-color-scheme: dark) {
+  .formula-editor-container {
+    background: #1a1a1a;
+  }
+
+  .function-palette,
+  .formula-input-section,
+  .preview-section,
+  .formula-examples {
+    background: #2a2a2a;
+    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
+  }
+
+  .function-palette h3,
+  .formula-input-section h3,
+  .preview-section h3,
+  .formula-examples h3,
+  .function-name,
+  .example-item strong {
+    color: #e0e0e0;
+  }
+
+  .function-search-input,
+  .formula-input,
+  .formula-toolbar button {
+    background: #333;
+    border-color: #444;
+    color: #e0e0e0;
+  }
+
+  .function-search-input:focus,
+  .formula-input:focus {
+    border-color: #4dabf7;
+    box-shadow: 0 0 0 2px rgba(77, 171, 247, 0.2);
+  }
+
+  .category-tab {
+    background: #333;
+    color: #ccc;
+  }
+
+  .category-tab.active {
+    background: #4dabf7;
+    color: white;
+  }
+
+  .function-item,
+  .example-item,
+  .preview-pane {
+    background: #333;
+  }
+
+  .function-item:hover,
+  .example-item:hover {
+    background: #3a3a3a;
+    border-color: #4dabf7;
+  }
+
+  .function-description,
+  .example-item code,
+  .status-message {
+    color: #aaa;
+  }
+}
diff --git a/assets/css/godaddy-uxcore-colors.css b/assets/css/godaddy-uxcore-colors.css
new file mode 100644
index 0000000..c13f5bc
--- /dev/null
+++ b/assets/css/godaddy-uxcore-colors.css
@@ -0,0 +1,257 @@
+/**
+ * Official GoDaddy UXCore Color Standards
+ * Based on GoDaddy Design System (Antares) and UXCore 2400+
+ *
+ * This file contains the official color tokens used across GoDaddy
+ * Reference: https://uxcore.uxp.gdcorp.tools/docs/foundations-design-system/antares/color-system/
+ */
+
+:root {
+    /* ============================================
+       BRAND PALETTE - Official GoDaddy Colors
+       ============================================ */
+
+    /* Primary Brand Colors */
+    --gd-brand-orange: #ff6900;
+    --gd-brand-orange-hover: #e55a00;
+    --gd-brand-orange-pressed: #cc4d00;
+    --gd-brand-orange-light: #fff4ec;
+    --gd-brand-orange-dark: #b33f00;
+
+    /* Brand Blacks & Whites */
+    --gd-brand-black: #111111;
+    --gd-brand-white: #ffffff;
+
+    /* ============================================
+       MONOCHROME PALETTE - Gray Scale System
+       ============================================ */
+
+    /* Stepped Gray Ramp (Recommended by UXCore) */
+    --gd-gray-0: #ffffff;
+    --gd-gray-50: #fafafa;
+    --gd-gray-100: #f5f5f5;
+    --gd-gray-200: #eeeeee;
+    --gd-gray-300: #e0e0e0;
+    --gd-gray-400: #bdbdbd;
+    --gd-gray-500: #9e9e9e;
+    --gd-gray-600: #757575;
+    --gd-gray-700: #616161;
+    --gd-gray-800: #424242;
+    --gd-gray-900: #212121;
+    --gd-gray-1000: #000000;
+
+    /* ============================================
+       SEMANTIC PALETTE - System Status Colors
+       ============================================ */
+
+    /* Success Colors */
+    --gd-success: #00a63f;
+    --gd-success-hover: #00953a;
+    --gd-success-light: #e6f7ed;
+    --gd-success-dark: #007a2f;
+
+    /* Error Colors */
+    --gd-error: #d72c0d;
+    --gd-error-hover: #c5290c;
+    --gd-error-light: #fdeae7;
+    --gd-error-dark: #b8240a;
+
+    /* Warning Colors */
+    --gd-warning: #ffb900;
+    --gd-warning-hover: #e6a700;
+    --gd-warning-light: #fff8e6;
+    --gd-warning-dark: #cc9500;
+
+    /* Info Colors */
+    --gd-info: #0073cf;
+    --gd-info-hover: #0066bb;
+    --gd-info-light: #e6f3fc;
+    --gd-info-dark: #005aa8;
+
+    /* ============================================
+       ACTION PALETTE - Interactive Elements
+       ============================================ */
+
+    /* Primary CTA (Call-to-Action) */
+    --gd-cta-primary: var(--gd-brand-orange);
+    --gd-cta-primary-hover: var(--gd-brand-orange-hover);
+    --gd-cta-primary-pressed: var(--gd-brand-orange-pressed);
+    --gd-cta-primary-light: var(--gd-brand-orange-light);
+
+    /* Secondary CTA */
+    --gd-cta-secondary: var(--gd-gray-600);
+    --gd-cta-secondary-hover: var(--gd-gray-700);
+    --gd-cta-secondary-light: var(--gd-gray-100);
+
+    /* ============================================
+       SEMANTIC TOKENS - Intent-Based Colors
+       ============================================ */
+
+    /* Background Colors */
+    --gd-background-primary: var(--gd-brand-white);
+    --gd-background-secondary: var(--gd-gray-50);
+    --gd-background-tertiary: var(--gd-gray-100);
+    --gd-background-overlay: rgba(0, 0, 0, 0.5);
+
+    /* Surface Colors */
+    --gd-surface-primary: var(--gd-brand-white);
+    --gd-surface-secondary: var(--gd-gray-50);
+    --gd-surface-elevated: var(--gd-brand-white);
+    --gd-surface-sunken: var(--gd-gray-100);
+
+    /* Text Colors */
+    --gd-text-primary: var(--gd-brand-black);
+    --gd-text-secondary: var(--gd-gray-700);
+    --gd-text-tertiary: var(--gd-gray-600);
+    --gd-text-muted: var(--gd-gray-500);
+    --gd-text-placeholder: var(--gd-gray-400);
+    --gd-text-inverse: var(--gd-brand-white);
+    --gd-text-brand: var(--gd-brand-orange);
+
+    /* Border Colors */
+    --gd-border-primary: var(--gd-gray-300);
+    --gd-border-secondary: var(--gd-gray-200);
+    --gd-border-tertiary: var(--gd-gray-100);
+    --gd-border-focus: var(--gd-brand-orange);
+    --gd-border-error: var(--gd-error);
+    --gd-border-success: var(--gd-success);
+
+    /* ============================================
+       DARK THEME OVERRIDES
+       ============================================ */
+
+    /* Background Colors - Dark */
+    --gd-dark-background-primary: var(--gd-gray-900);
+    --gd-dark-background-secondary: var(--gd-gray-800);
+    --gd-dark-background-tertiary: var(--gd-gray-700);
+
+    /* Surface Colors - Dark */
+    --gd-dark-surface-primary: var(--gd-gray-800);
+    --gd-dark-surface-secondary: var(--gd-gray-700);
+    --gd-dark-surface-elevated: var(--gd-gray-700);
+    --gd-dark-surface-sunken: var(--gd-gray-900);
+
+    /* Text Colors - Dark */
+    --gd-dark-text-primary: var(--gd-gray-50);
+    --gd-dark-text-secondary: var(--gd-gray-200);
+    --gd-dark-text-tertiary: var(--gd-gray-300);
+    --gd-dark-text-muted: var(--gd-gray-400);
+    --gd-dark-text-placeholder: var(--gd-gray-500);
+
+    /* Border Colors - Dark */
+    --gd-dark-border-primary: var(--gd-gray-600);
+    --gd-dark-border-secondary: var(--gd-gray-700);
+    --gd-dark-border-tertiary: var(--gd-gray-800);
+
+    /* ============================================
+       SPECIAL PALETTES FROM UXCORE DOCS
+       ============================================ */
+
+    /* Minimal Color Palettes (from GoDaddy Studio) */
+    --gd-palette-hazel-wood-1: #d3c9c2;
+    --gd-palette-hazel-wood-2: #dbdbdb;
+    --gd-palette-hazel-wood-3: #ba9469;
+    --gd-palette-hazel-wood-4: #f9f2e5;
+    --gd-palette-hazel-wood-5: #2e2e2e;
+
+    --gd-palette-ava-1: #ffffff;
+    --gd-palette-ava-2: #f6f6f6;
+    --gd-palette-ava-3: #a2a3a4;
+    --gd-palette-ava-4: #000000;
+
+    --gd-palette-bordeaux-1: #dfd4d7;
+    --gd-palette-bordeaux-2: #e1dbcd;
+    --gd-palette-bordeaux-3: #b38883;
+    --gd-palette-bordeaux-4: #683838;
+}
+
+/* ============================================
+   THEME SWITCHING UTILITIES
+   ============================================ */
+
+/* Light theme (default) */
+[data-theme="light"],
+:root {
+    --current-background-primary: var(--gd-background-primary);
+    --current-background-secondary: var(--gd-background-secondary);
+    --current-surface-primary: var(--gd-surface-primary);
+    --current-text-primary: var(--gd-text-primary);
+    --current-text-secondary: var(--gd-text-secondary);
+    --current-border-primary: var(--gd-border-primary);
+}
+
+/* Dark theme */
+[data-theme="dark"] {
+    --current-background-primary: var(--gd-dark-background-primary);
+    --current-background-secondary: var(--gd-dark-background-secondary);
+    --current-surface-primary: var(--gd-dark-surface-primary);
+    --current-text-primary: var(--gd-dark-text-primary);
+    --current-text-secondary: var(--gd-dark-text-secondary);
+    --current-border-primary: var(--gd-dark-border-primary);
+}
+
+/* ============================================
+   UTILITY CLASSES FOR COLOR APPLICATION
+   ============================================ */
+
+.gd-color-brand { color: var(--gd-brand-orange) !important; }
+.gd-color-success { color: var(--gd-success) !important; }
+.gd-color-error { color: var(--gd-error) !important; }
+.gd-color-warning { color: var(--gd-warning) !important; }
+.gd-color-info { color: var(--gd-info) !important; }
+
+.gd-bg-brand { background-color: var(--gd-brand-orange) !important; }
+.gd-bg-success { background-color: var(--gd-success) !important; }
+.gd-bg-error { background-color: var(--gd-error) !important; }
+.gd-bg-warning { background-color: var(--gd-warning) !important; }
+.gd-bg-info { background-color: var(--gd-info) !important; }
+
+.gd-border-brand { border-color: var(--gd-brand-orange) !important; }
+.gd-border-success { border-color: var(--gd-success) !important; }
+.gd-border-error { border-color: var(--gd-error) !important; }
+.gd-border-warning { border-color: var(--gd-warning) !important; }
+.gd-border-info { border-color: var(--gd-info) !important; }
+
+/* ============================================
+   ACCESSIBILITY HELPERS
+   ============================================ */
+
+.gd-high-contrast {
+    --gd-text-primary: var(--gd-brand-black);
+    --gd-border-primary: var(--gd-gray-600);
+}
+
+.gd-reduced-motion {
+    --gd-transition-duration: 0.01ms !important;
+    --gd-animation-duration: 0.01ms !important;
+}
+
+/* ============================================
+   DOCUMENTATION REFERENCE
+   ============================================ */
+
+/*
+ * COLOR USAGE GUIDELINES:
+ *
+ * 1. Brand Colors:
+ *    - Use --gd-brand-orange for primary actions, links, and brand elements
+ *    - Use hover/pressed states for interactive elements
+ *
+ * 2. Monochrome Palette:
+ *    - Use grays 100-300 for backgrounds
+ *    - Use grays 400-600 for borders and secondary text
+ *    - Use grays 700-900 for primary text
+ *
+ * 3. Semantic Colors:
+ *    - Use semantic colors consistently across the app
+ *    - Always pair with appropriate light variants for backgrounds
+ *
+ * 4. Dark Theme:
+ *    - Flip the lightness values
+ *    - Maintain contrast ratios for accessibility
+ *
+ * 5. Accessibility:
+ *    - Ensure minimum 4.5:1 contrast ratio for normal text
+ *    - Ensure minimum 3:1 contrast ratio for large text
+ *    - Test with color blindness simulators
+ */
