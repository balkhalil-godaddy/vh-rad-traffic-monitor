+    
+    # Check for nested parentheses depth
+    max_depth = 0
+    current_depth = 0
+    for char in formula:
+        if char == '(':
+            current_depth += 1
+            max_depth = max(max_depth, current_depth)
+        elif char == ')':
+            current_depth -= 1
+            if current_depth < 0:
+                errors.append("Closing parenthesis without opening parenthesis")
+                break
+    
+    if max_depth > 10:
