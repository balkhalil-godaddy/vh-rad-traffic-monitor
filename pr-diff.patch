+.ux-text--heading-2 { font-size: 2rem; font-weight: 700; }
+.ux-text--heading-3 { font-size: 1.5rem; font-weight: 600; }
+.ux-text--heading-4 { font-size: 1.25rem; font-weight: 600; }
+.ux-text--body-1 { font-size: 1rem; }
+.ux-text--body-2 { font-size: 0.875rem; }
+
+/* UXCore Icon Styles */
+.ux-icon {
+    display: inline-flex;
+    width: 1em;
+    height: 1em;
+    fill: currentColor;
+}
+
+.ux-icon--close::before { content: "×"; font-size: 1.5em; }
+.ux-icon--close-small::before { content: "×"; }
+.ux-icon--info::before { content: "ⓘ"; }
+.ux-icon--success::before { content: "✓"; }
+.ux-icon--warning::before { content: "⚠"; }
+.ux-icon--error::before { content: "✕"; }
+
+/* Body class for modal open state */
+body.ux-modal-open {
+    overflow: hidden;
+}
