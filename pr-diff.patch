+}
+
+.card .label {
+    font-size: var(--gd-font-size-sm);
+    text-transform: uppercase;
+    font-weight: var(--gd-font-weight-medium);
+    letter-spacing: 0.05em;
+    margin-bottom: var(--gd-spacing-sm);
+}
+
+.card .value {
+    font-size: var(--gd-font-size-5xl);
+    font-weight: var(--gd-font-weight-bold);
+    line-height: 1;
+    margin: var(--gd-spacing-sm) 0;
+}
+
+.card .subtitle {
+    font-size: var(--gd-font-size-sm);
+    opacity: 0.8;
+}
+
+/* ============================================
+   Filters & Search
+   ============================================ */
+
+.filters {
+    display: flex;
+    align-items: center;
+    gap: var(--gd-spacing-lg);
+    margin-bottom: var(--gd-spacing-lg);
+    flex-wrap: wrap;
+}
+
+.search-input {
+    flex: 1;
+    min-width: 300px;
+    height: 52px;
+    padding: 0 var(--gd-spacing-md);
+    font-family: var(--gd-font-family-primary);
+    font-size: var(--gd-font-size-md);
+    line-height: var(--gd-line-height-interface);
+    color: var(--gd-color-text-primary);
+    background-color: var(--gd-color-surface);
