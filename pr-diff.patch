+  }
+
+  isAutocompleteVisible() {
+    return this.autocompleteContainer.classList.contains('visible');
+  }
+
+  triggerAutocomplete() {
+    this.performAutocomplete();
+  }
+
+  // History management
+  addToHistory(value) {
