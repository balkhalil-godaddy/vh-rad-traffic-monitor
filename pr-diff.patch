+            return {
+                "summary": {
+                    "passed": self.passed,
+                    "failed": self.failed,
+                    "warnings": self.warnings,
+                    "errors": self.errors,
+                    "total": self.passed + self.failed,
+                    "success": self.failed == 0 and self.errors == 0,
+                    "duration": duration,
