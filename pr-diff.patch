-  "events": [
-    {
-      "event_id": "pandc.vnext.recommendations.feed.feed.load",
-      "display_name": "feed.load",
-      "current_count": 1234,
-      "baseline_count": 10000,
-      "baseline_period": 625.0,
-      "daily_avg": 1250.0,
-      "score": 97,
-      "status": "INCREASED"
-    }
-  ],
