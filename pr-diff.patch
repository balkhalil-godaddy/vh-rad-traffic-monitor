+/**
+ * Integration tests for EMIL components
+ */
+
+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { JSDOM } from 'jsdom';
+import { EIDRegistry } from '../../../assets/js/emil/eid-registry/eid-registry.js';
